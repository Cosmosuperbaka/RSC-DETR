# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/
build/
dist/

# Editors / OS / local secrets
.vscode/
.idea/
.DS_Store
Thumbs.db
.env
.env.*

# WorkBuddy / Qoder session data
.workbuddy/
.qoder-credits/

# Renderer output — figures are regenerated on the experiment server
out_qual/
outputs/
figures/out/
*.log

# Datasets: ignore the data entities, keep the preparation README and the
# M3FD-LT20 reproducibility record (split lists, manifests, counts, scripts).
# Anchored to the repo root so src/data/ — the dataloader sources — stays tracked.
/data/
datasets/*
!datasets/README.md
!datasets/M3FD/
!datasets/M3FD/reproducibility/
!datasets/M3FD/reproducibility/**
datasets/M3FD/raw/
datasets/M3FD/processed/
datasets/M3FD/reproducibility/build/

# Experiment artifacts
runs/
wandb/
checkpoints/
events.out.tfevents.*
*.npy
*.npz

# Model weights: weights/*.pth is tracked through Git LFS (see .gitattributes);
# every other weight format stays out of the repository.
*.pt
*.ckpt
*.pkl
*.onnx
*.engine
*.safetensors

# Archives are distributed through GitHub Releases
*.zip
*.tar
*.tar.gz
*.tgz

# Generated LaTeX artifacts
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
